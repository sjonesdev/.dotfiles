# GitHub HTTPS authentication
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://codeberg.org"]
	username = sjonesdev

# Personal identity and GPG signing (GitHub and Codeberg)
[user]
	email = spjones329@gmail.com
	name = Samuel P. Jones
[gpg]
	format = openpgp
[commit]
	gpgsign = true

# Machine-specific personal signing key, generated during setup and stowed.
[include]
	path = ~/.gitconfig-local

# Work identity and SSH signing override the personal defaults.
[includeIf "hasconfig:remote.*.url:git@github.com:flexport/**"]
	path = ~/.dotfiles/git/dot-gitconfig-work
[includeIf "hasconfig:remote.*.url:https://github.com/flexport/**"]
	path = ~/.dotfiles/git/dot-gitconfig-work

# Shared settings
[core]
	editor = nano
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[push]
	default = current
